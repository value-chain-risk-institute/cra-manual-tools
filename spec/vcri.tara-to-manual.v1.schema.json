{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/value-chain-risk-institute/cra-manual-tools/tree/main/spec/vcri.tara-to-manual.v1.schema.json",
  "title": "vcri.tara-to-manual/v1: TARA results in the Cyber Manual's shape",
  "description": "Joshua Marpet and Cairn Viktor, The Value Chain Risk Institute, 2026. CC BY 4.0. See README.md.",
  "type": "object",
  "required": [
    "schema",
    "ri",
    "cu",
    "sp"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^vcri\\.tara-to-manual/v1\\.\\d+$",
      "description": "Format and version, \"vcri.tara-to-manual/v1.0\". Readers accept any 1.x."
    },
    "generator": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "version"
      ]
    },
    "tpl": {
      "type": "string"
    },
    "generated": {
      "type": "string",
      "format": "date-time"
    },
    "product": {
      "type": "string"
    },
    "ri": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "Local reference, unique within this file."
          },
          "source": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "description": "Who gave the IDs, e.g. \"vcri-tara\" or another tool's name."
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "tool",
              "ids"
            ]
          },
          "title": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "fcIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^FC\\d+$"
            },
            "uniqueItems": true
          },
          "cuIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CU\\d+$"
            },
            "uniqueItems": true,
            "description": "Conditions of use already in the manual."
          },
          "cuRefs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "refs of condition-of-use candidates in this file."
          },
          "risk": {
            "type": "string"
          }
        },
        "required": [
          "ref",
          "title"
        ]
      }
    },
    "cu": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "Local reference, unique within this file."
          },
          "source": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "description": "Who gave the IDs, e.g. \"vcri-tara\" or another tool's name."
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "tool",
              "ids"
            ]
          },
          "affected": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "annex": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^2[b-m]$"
            },
            "uniqueItems": true
          },
          "fcIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^FC\\d+$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "ref",
          "title"
        ]
      }
    },
    "sp": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "Local reference, unique within this file."
          },
          "source": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "description": "Who gave the IDs, e.g. \"vcri-tara\" or another tool's name."
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "tool",
              "ids"
            ]
          },
          "comp": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "annex": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^2[b-m]$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "ref",
          "title"
        ]
      }
    }
  }
}