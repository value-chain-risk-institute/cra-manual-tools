{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/value-chain-risk-institute/cra-manual-tools/tree/main/spec/vcri.tara.v1.schema.json",
  "title": "vcri.tara/v1: a threat analysis and risk assessment",
  "description": "Joshua Marpet and Cairn Viktor, The Value Chain Risk Institute, 2026. CC BY 4.0. See README.md.",
  "type": "object",
  "required": [
    "schema",
    "data"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^vcri\\.tara/v1\\.\\d+$",
      "description": "Format and version, \"vcri.tara/v1.0\". Readers accept any 1.x."
    },
    "generator": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "version"
      ]
    },
    "spec": {
      "type": "string"
    },
    "rubric": {
      "type": "string"
    },
    "generated": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "product": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "ver": {
              "type": "string"
            },
            "purpose": {
              "type": "string"
            }
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^IF\\d+$"
              },
              "name": {
                "type": "string"
              },
              "inScope": {
                "type": "boolean"
              },
              "custom": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "inScope"
            ]
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^A\\d+$"
              },
              "name": {
                "type": "string"
              },
              "damage": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^TS\\d+$"
              },
              "legacyId": {
                "type": "string"
              },
              "key": {
                "type": "string",
                "description": "<class>|<interface ID>"
              },
              "cls": {
                "enum": [
                  "AUTH",
                  "INTEG",
                  "CONF",
                  "AVAIL",
                  "AUTHZ",
                  "FRESH",
                  "PROV",
                  "PHYS"
                ]
              },
              "clsName": {
                "type": "string"
              },
              "ifaceId": {
                "type": "string",
                "pattern": "^IF\\d+$"
              },
              "text": {
                "type": "string"
              },
              "accepted": {
                "type": "boolean"
              },
              "feas": {
                "type": "object",
                "properties": {
                  "time": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "expertise": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "knowledge": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "window": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "equipment": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  }
                }
              },
              "imp": {
                "type": "object",
                "properties": {
                  "safety": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  "operational": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  "financial": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  "privacy": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  }
                }
              },
              "treatment": {
                "enum": [
                  "",
                  "reduce",
                  "retain",
                  "avoid",
                  "transfer"
                ]
              },
              "bearer": {
                "enum": [
                  "",
                  "manufacturer",
                  "user"
                ]
              },
              "annex": {
                "type": "string",
                "pattern": "^(2[b-m])?$"
              },
              "fcIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^FC\\d+$"
                },
                "uniqueItems": true
              },
              "cuIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^CU\\d+$"
                },
                "uniqueItems": true
              },
              "assetIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^A\\d+$"
                },
                "uniqueItems": true
              },
              "damage": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "key",
              "cls",
              "ifaceId",
              "text",
              "accepted",
              "feas",
              "imp",
              "treatment",
              "bearer",
              "fcIds",
              "cuIds"
            ]
          }
        },
        "cm": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "fc": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^FC\\d+$"
                      },
                      "title": {
                        "type": "string"
                      },
                      "cus": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id"
                    ]
                  }
                },
                "cu": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^CU\\d+$"
                      },
                      "title": {
                        "type": "string"
                      },
                      "affected": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id"
                    ]
                  }
                },
                "sp": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^SP\\d+$"
                      },
                      "title": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id"
                    ]
                  }
                },
                "tpl": {
                  "type": "string"
                },
                "schema": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "nextId": {
          "type": "object",
          "properties": {
            "A": {
              "type": "integer",
              "minimum": 1
            },
            "IF": {
              "type": "integer",
              "minimum": 1
            },
            "TS": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "A",
            "IF",
            "TS"
          ]
        }
      },
      "required": [
        "product",
        "interfaces",
        "assets",
        "scenarios",
        "nextId"
      ]
    }
  }
}